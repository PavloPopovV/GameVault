// GameVault — ER-діаграма. Вставити на https://dbdiagram.io/d і експортувати PNG.
Project GameVault {
  database_type: 'PostgreSQL'
}

Enum role {
  USER
  ADMIN
}

Enum library_status {
  WANT_TO_PLAY
  PLAYING
  COMPLETED
  DROPPED
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  username varchar(32) [not null, unique]
  password_hash varchar(255) [not null]
  role role [not null, default: 'USER']
  created_at timestamp [not null, default: `now()`]
}

Table profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - users.id]
  bio varchar(200)
  avatar bytea [note: 'фото профілю, ≤ 200 КБ']
  avatar_mime varchar(20)
  avatar_updated_at timestamp
  updated_at timestamp [not null]
}

Table games {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(150) [not null, unique]
  slug varchar(160) [not null, unique]
  description text
  release_year int
  cover_url varchar(500)
  developer varchar(100)
  created_at timestamp [not null, default: `now()`]
}

Table genres {
  id serial [pk]
  name varchar(50) [not null, unique]
}

Table platforms {
  id serial [pk]
  name varchar(50) [not null, unique]
}

Table game_genres {
  game_id uuid [not null, ref: > games.id]
  genre_id int [not null, ref: > genres.id]
  indexes {
    (game_id, genre_id) [pk]
  }
}

Table game_platforms {
  game_id uuid [not null, ref: > games.id]
  platform_id int [not null, ref: > platforms.id]
  indexes {
    (game_id, platform_id) [pk]
  }
}

Table library_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  game_id uuid [not null, ref: > games.id]
  status library_status [not null, default: 'WANT_TO_PLAY']
  completed_at timestamp
  added_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  indexes {
    (user_id, game_id) [unique]
    (user_id, status)
  }
}

Table wishlist_items {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  game_id uuid [not null, ref: > games.id]
  added_at timestamp [not null, default: `now()`]
  indexes {
    (user_id, game_id) [unique]
  }
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  game_id uuid [not null, ref: > games.id]
  rating smallint [not null, note: 'CHECK 1..10']
  text text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  indexes {
    (user_id, game_id) [unique]
    game_id
  }
}

Table review_votes {
  review_id uuid [not null, ref: > reviews.id]
  user_id uuid [not null, ref: > users.id]
  value smallint [not null, note: 'CHECK -1 (дизлайк) / 1 (лайк)']
  created_at timestamp [not null, default: `now()`]
  indexes {
    (review_id, user_id) [pk]
  }
}
