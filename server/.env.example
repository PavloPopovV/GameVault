# Скопіюйте цей файл у .env і заповніть власними значеннями.
# .env ніколи не комітиться в репозиторій.

# Рядок підключення до PostgreSQL (локально або Neon)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamevault"

# Секрет для підпису JWT (довгий випадковий рядок)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"

# Порт API та адреса фронтенду для CORS
PORT=4000
CLIENT_URL="http://localhost:5173"

# Необов'язково: ключ RAWG для імпорту обкладинок (npm run covers:rawg)
# https://rawg.io/apidocs
RAWG_API_KEY=

# Окрема БД лише для інтеграційних тестів (npm run test:integration) — її дані видаляються!
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gamevault_test"
